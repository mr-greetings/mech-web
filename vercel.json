{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "functions": {
        "api/**/*.js": {
            "maxDuration": 30,
            "includeFiles": "data/*.json"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/[...route]"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}